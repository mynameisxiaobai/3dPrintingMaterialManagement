# 国内 npm 加速：默认走 npmmirror（淘宝源）
#
# 本仓库的 package-lock.json 里 tarball 地址已经是 registry.npmmirror.com，
# 所以直接 npm install / npm ci 就是走镜像。
#
# replace-registry-host=always 是兜底：npm 10 默认值 npmjs 已经会替换域名，
# 但如果你哪天用官方源重跑过 npm install（锁文件地址翻回 npmjs），
# 或换了自带旧版 npm 的环境，这一行能保证不会悄悄卡在 registry.npmjs.org。
# 想临时全部走官方源：npm ci --registry=https://registry.npmjs.org --replace-registry-host=never
registry=https://registry.npmmirror.com
replace-registry-host=always

# 少打点无关输出
fund=false
audit=false
